{
  // The site is deployed as a Cloudflare Worker with static assets (Workers Builds).
  "name": "universities500",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only the API addresses run the Worker; pages and files are served straight from dist/.
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  // Keep the variables and secrets set in the Cloudflare dashboard when this config deploys.
  "keep_vars": true,
  "observability": { "enabled": true }
}
