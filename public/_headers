# Keep the free preview addresses out of search results while the site is a draft.
# These rules match only the pages.dev and workers.dev hosts, so they do not affect universities500.com once that is attached.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:project.:account.workers.dev/*
  X-Robots-Tag: noindex

# Account pages have no public content. Their data is loaded after sign-in, never written into the page.
/sign-in/*
  X-Robots-Tag: noindex
/student/*
  X-Robots-Tag: noindex
