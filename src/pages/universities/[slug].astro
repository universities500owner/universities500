---
import '../../styles/university.css';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import SocialIcons from '../../components/SocialIcons.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import { profileFor, num, esc, host } from '../../lib/profiles.js';
import { forDestination } from '../../lib/articles.js';
import { all, blurb, related, fmtDate, SITE } from '../../lib/data.js';
import { itemsFor, hubFor, statusOf, STATUS_LABEL, fmtIso, scholarshipsLink, PUBLISH } from '../../lib/scholarships.js';
import { itemsFor as coursesFor, path as coursePath, lengthText, feeText } from '../../lib/courses.js';
import { rankingSites } from '../../lib/rankingSites.js';

export function getStaticPaths() {
  return all.map((u) => ({ params: { slug: u.slug }, props: { u } }));
}
const { u } = Astro.props;
const peers = related(u);
const schol = itemsFor(u.slug).slice(0, 6);
const sLink = scholarshipsLink(u);
const courses = coursesFor(u.slug);
const bachelors = courses.filter((c) => c.level === 'Bachelor');
const masters = courses.filter((c) => c.level === 'Master');

// The checked profile, when this university has one; everything below also works without it.
const P = profileFor(u.slug) || {};
const links = P.links || {};
// Only campuses the university's own page names. Wikidata gives where the university is (P.place), not its campuses.
const camps = P.campuses || [];
const withPhoto = camps.filter((c) => c.photo);
const noPhoto = camps.filter((c) => !c.photo);
const faculties = P.faculties || [];
const gallery = P.gallery || [];
const partners = P.partners || [];
// Industry connections stays hidden until we hold partner names for most universities (38 of 263 today). Set to true to show it again.
const SHOW_INDUSTRY = false;
// Big photos for the header slideshow: wide ones with a 1280px copy
const hero = gallery.filter((g) => g.u2 && g.w && g.h && g.w / g.h >= 1.3).slice(0, 5);
const heroH = (g) => Math.round(1280 * g.h / g.w);
const slides = gallery.map((g) => ({ ...g, src: g.u2 || g.u, sw: g.u2 ? 1280 : g.w, sh: g.u2 ? Math.round(1280 * g.h / g.w) : g.h }));
const initials = (n) => n.replace(/\(.*?\)/g, '').split(/\s+/).filter(Boolean).map((w) => w[0]).filter((c) => /\p{L}/u.test(c)).slice(0, 2).join('').toUpperCase();
const facHref = (f) => f.url || links.faculties || web;
const hasOverview = !P.brief && !!u.overview;
const lede = P.brief || (u.overview ? (u.overview.length > 600 ? blurb(u.overview, 600) : u.overview) : '');
const web = u.web || '';
const credit = (ph) => ph && ph.by ? ph : null;
const pages = [
  links.admissions && { href: links.admissions, title: 'Admissions', text: 'How to apply, entry requirements and key dates.' },
  links.courses && { href: links.courses, title: 'Programs offered', text: 'The full list of courses on the university\'s own site.' },
  links.scholarships && { href: links.scholarships, title: 'Scholarships', text: 'Funding the university offers international students.' },
].filter(Boolean);

const title = `${u.name}: facts, campuses and official links | Universities500`;
const description = P.brief
  ? blurb(P.brief, 150)
  : u.overview
  ? blurb(u.overview, 150)
  : `${u.name} in ${u.countryName}: official website and basic facts, with sources.`;

const sameAs = [u.wikidata, u.overviewSrc, ...Object.values(P.social || {})].filter(Boolean);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'CollegeOrUniversity',
  name: u.name,
  url: u.web || undefined,
  foundingDate: P.established?.v ? String(P.established.v) : u.founded?.v,
  description: P.brief || undefined,
  address: { '@type': 'PostalAddress', addressCountry: u.countryName },
  sameAs,
};
---
<Base title={title} description={description} path={`/universities/${u.slug}/`} noindex={!u.listed} jsonld={ld} current="universities" share={false}>
  <div slot="head" class={hero.length ? 'uni-hero has-photos' : 'uni-hero'} data-hero>
    {hero.length > 0 && (
      <div class="uni-hero-bg" aria-hidden="true">
        {hero.map((g, i) => (
          <img class={i === 0 ? 'is-on' : ''} src={i === 0 ? g.u2 : undefined} data-src={i > 0 ? g.u2 : undefined} width="1280" height={heroH(g)} alt="" decoding="async" fetchpriority={i === 0 ? 'high' : 'low'}
            data-by={g.by} data-y={g.y || ''} data-lic={g.lic} data-licurl={g.licUrl || g.page} data-page={g.page} />
        ))}
      </div>
    )}
    <PageHead crumbs={[['Universities', '/universities/'], [u.countryName, `/study-in/${u.country}/`]]} title={u.name}>
      {lede && <p class="pg-lede uni-brief" set:html={esc(lede)} />}
      {hasOverview && (
        <p class="uni-credit">Summary from <a href={u.overviewSrc}>Wikipedia</a> (<a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>){u.overviewTrimmed ? ', shortened' : ''}.</p>
      )}
      <div class="uni-actions">
        {web && <a class="btn" href={web} rel="noopener">Official website</a>}
        <SocialIcons links={P.social} name={u.name} />
      </div>
    </PageHead>
    {hero.length > 0 && (
      <div class="uni-hero-meta">
        <div class="wrap">
          <p class="uni-hero-cr" data-cr>Photo: {hero[0].by}{hero[0].y ? `, ${hero[0].y}` : ''}, <a href={hero[0].licUrl || hero[0].page} rel="noopener">{hero[0].lic}</a>, <a href={hero[0].page} rel="noopener">Wikimedia Commons</a></p>
          {hero.length > 1 && <button type="button" class="uni-hero-pause" aria-pressed="false">Pause photos</button>}
        </div>
      </div>
    )}
  </div>
  <div slot="head" class="uni-facts">
    <div class="wrap">
      <dl>
        <div><dt>Country</dt><dd>{u.countryName}</dd></div>
        {P.place && camps.length === 0 && (
          <div><dt>Location</dt><dd>{P.place.name}</dd><small class="uni-src"><a href={P.place.maps} rel="noopener" target="_blank">View on Google Maps</a></small></div>
        )}
        {(P.established || u.founded) && (
          <div>
            <dt>Established</dt>
            <dd>{P.established ? P.established.v : u.founded.v}</dd>
            {P.established?.note && <small class="uni-note">{P.established.note}</small>}
            <small class="uni-src">{P.established ? (P.established.source) : 'Source: Wikidata'}</small>
          </div>
        )}
        {P.students && (
          <div>
            <dt>Students</dt>
            <dd>{num(P.students.v)}</dd>
            <small class="uni-note">as on {P.students.asof}</small>
            <small class="uni-src">{P.students.source}</small>
          </div>
        )}
        {web && <div><dt>Website</dt><dd><a href={web} rel="noopener">{host(web)}</a></dd></div>}
      </dl>
    </div>
  </div>

  {camps.length > 0 && (
    <section class="sec" aria-labelledby="campuses">
      <h2 id="campuses">Campuses</h2>
      {withPhoto.length > 0 && (
        <ul class="uni-camps">
          {withPhoto.map((c) => (
            <li>
              <img src={c.photo.u} width={c.photo.w} height={c.photo.h || undefined} alt={`${c.name}, ${u.name}`} loading="lazy" decoding="async" />
              <div class="uni-camp-body">
                <a class="uni-pin" href={c.maps} rel="noopener" target="_blank">
                  <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 14.5s4.7-4.2 4.7-7.9A4.7 4.7 0 0 0 3.3 6.6c0 3.7 4.7 7.9 4.7 7.9Z" /><circle cx="8" cy="6.6" r="1.7" /></svg>
                  <span>{c.name}</span><span class="sr-only"> on Google Maps</span>
                </a>
                <p class="uni-cr">Photo: {c.photo.by}, <a href={c.photo.licUrl || c.photo.page} rel="noopener">{c.photo.lic}</a>, <a href={c.photo.page} rel="noopener">Wikimedia Commons</a></p>
              </div>
            </li>
          ))}
        </ul>
      )}
      {noPhoto.length > 0 && (
        <ul class="uni-pins">
          {noPhoto.map((c) => (
            <li>
              <a class="uni-pin" href={c.maps} rel="noopener" target="_blank">
                <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 14.5s4.7-4.2 4.7-7.9A4.7 4.7 0 0 0 3.3 6.6c0 3.7 4.7 7.9 4.7 7.9Z" /><circle cx="8" cy="6.6" r="1.7" /></svg>
                <span>{c.name}</span><span class="sr-only"> on Google Maps</span>
              </a>
            </li>
          ))}
        </ul>
      )}
      <p class="small">Campuses the university names on its own website. Check the website for the full list.</p>
    </section>
  )}

  {faculties.length > 0 && (
    <section class="sec" aria-labelledby="faculties">
      <h2 id="faculties">Faculties and departments</h2>
      <ul class="uni-facs">
        {faculties.map((f) => <li><a href={facHref(f)} rel="noopener">{f.name}</a></li>)}
      </ul>
      <p class="small">As named by the university. Each name opens the faculty's own page where we found it, and the university's website where we did not. Not every department is listed.</p>
    </section>
  )}

  {pages.length > 0 && (
    <section class="sec" aria-labelledby="official">
      <h2 id="official">Official pages</h2>
      <ul class="uni-pages">
        {pages.map((x) => (
          <li><a href={x.href} rel="noopener"><strong>{x.title}<svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3l5 5-5 5" /></svg></strong><span>{x.text}</span><em>{host(x.href)}</em></a></li>
        ))}
      </ul>
    </section>
  )}

  {slides.length >= 4 && (
    <section class="sec" aria-labelledby="gallery">
      <h2 id="gallery">Campus gallery</h2>
      <div class="uni-slider" data-slider>
        <div class="uni-track" tabindex="0" role="region" aria-label={`${u.name} campus photos`}>
          {slides.map((g, i) => (
            <figure>
              <a href={g.page} rel="noopener" target="_blank"><img src={g.src} width={g.sw} height={g.sh || undefined} alt={`${u.name} campus photo ${i + 1}`} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" /></a>
              <figcaption>Photo: {g.by}{g.y ? `, ${g.y}` : ''}, <a href={g.licUrl || g.page} rel="noopener">{g.lic}</a>, <a href={g.page} rel="noopener">Wikimedia Commons</a></figcaption>
            </figure>
          ))}
        </div>
        <button type="button" class="uni-prev" aria-label="Previous photo"><svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3L5 8l5 5" /></svg></button>
        <button type="button" class="uni-next" aria-label="Next photo"><svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3l5 5-5 5" /></svg></button>
        <p class="uni-count" aria-live="polite"><span data-n>1</span> / {slides.length}</p>
      </div>
    </section>
  )}

  {SHOW_INDUSTRY && (partners.length > 0 || links.partners) && (
    <section class="sec" aria-labelledby="industry">
      <h2 id="industry">Industry connections</h2>
      <div class="uni-industry">
        {partners.length > 0 && (
          <Fragment>
            <p>Organisations this university names as partners on its own website.</p>
            <ul class="uni-partners">{partners.map((n) => <li>{n}</li>)}</ul>
          </Fragment>
        )}
        {links.partners && (
          <p class="uni-more"><a href={links.partners} rel="noopener">{partners.length > 0 ? 'See the full list on the university\'s partnerships page' : `See ${u.name}'s industry and partnerships page`}</a> <span class="muted">({host(links.partners)})</span></p>
        )}
      </div>
    </section>
  )}

  {!P.established && (u.stats || []).length > 0 && (
    <section class="sec" aria-labelledby="facts">
      <h2 id="facts">More facts</h2>
      <table class="facts">
        <tbody>
          {(u.stats || []).map((s) => (
            <tr>
              <th scope="row">{s.l}</th>
              <td>{s.v}{s.a ? ` (${s.a})` : ''}<a class="source" href={s.src}>Source: Wikidata. Can be out of date.</a></td>
            </tr>
          ))}
          {u.ig && !P.social && <tr><th scope="row">Instagram</th><td><a href={u.ig} rel="noopener">Official account</a></td></tr>}
          {u.yt && !P.social && <tr><th scope="row">YouTube</th><td><a href={u.yt} rel="noopener">Official channel</a></td></tr>}
        </tbody>
      </table>
      {u.read && <p class="small">Data read on {fmtDate(u.read)}. Check the university's own site for current details.</p>}
    </section>
  )}
  {P.name && (
    <p class="small uni-checked">Profile checked on {fmtDate(P.generated)}. Each figure names its source. Check the university's own site for current details.</p>
  )}

  {PUBLISH && (schol.length > 0 || sLink) && (
    <section class="sec" aria-labelledby="schol">
      <h2 id="schol">Scholarships for international students</h2>
      <ul class="uni-schol">
        {schol.map((s) => (
          <li>
            <a href={`/scholarships/${s.slug}/`}>
              <strong>{s.name}</strong>
              <span class="uni-chip">{STATUS_LABEL[statusOf(s)]}</span>
              {s.deadline && <small>Deadline {fmtIso(s.deadline)}</small>}
            </a>
          </li>
        ))}
        {sLink && sLink.kind === 'page' && (
          <li class="uni-schol-own"><a href={sLink.url} rel="noopener"><strong>{u.name}'s own scholarships page</strong><small>{sLink.checked ? `Checked ${fmtIso(sLink.checked)}` : host(sLink.url)}</small></a></li>
        )}
        {sLink && sLink.kind === 'search' && (
          <li class="uni-schol-own"><a href={sLink.url} rel="noopener"><strong>Search {u.name}'s website for scholarships</strong>{schol.length === 0 && <small>We have not read scholarships from this university's website yet.</small>}</a></li>
        )}
      </ul>
      <p class="small">{schol.length > 0 && 'Read by a program from the university\'s website. '}Check the official page before you apply. <a href="/scholarships/">Search all scholarships</a></p>
    </section>
  )}

  {courses.length > 0 && (
    <section class="sec" aria-labelledby="courses">
      <h2 id="courses">Courses read from the university's website</h2>
      <p>{courses.length} Bachelor's and Master's course{courses.length === 1 ? '' : 's'} that are full-time on campus and open to international students. This is what our reader could confirm from the course pages, not every course the university offers.</p>
      {[["Bachelor's", bachelors], ["Master's", masters]].map(([label, list]) => list.length > 0 && (
        <details open={courses.length <= 12}>
          <summary>{label} <span class="muted">({list.length})</span></summary>
          <ul class="uni-courses">
            {list.map((c) => <li><a href={coursePath(c)}>{c.name}</a> <span class="muted">{lengthText(c)}{c.fee ? `, fee ${feeText(c)}` : ''}</span></li>)}
          </ul>
        </details>
      ))}
      <p class="small">Each course page shows the sentence every fact was copied from. Check the official page before you apply. <a href="/courses/">Search all courses</a></p>
    </section>
  )}

  {u.alumni && u.alumni.length > 0 && (
    <section class="sec" aria-labelledby="alumni">
      <h2 id="alumni">People who studied here</h2>
      <ul class="uni-people">
        {u.alumni.map((a) => (
          <li>
            <span class="uni-ini" aria-hidden="true">{initials(a.n)}</span>
            <div><a href={a.u} rel="noopener">{a.n}</a>{a.w && <small>{a.w}</small>}</div>
          </li>
        ))}
      </ul>
      <p class="small">From Wikidata, where "educated at" names this university. It is not a complete list.</p>
    </section>
  )}

  <section class="sec" aria-labelledby="rank">
    <h2 id="rank">Rankings</h2>
    <p>Ranking sites measure different things, so a university can look very different on each. We don't copy their numbers. Open each site to see how {u.name} appears.</p>
    <ul class="uni-rank">
      {rankingSites.map((r) => (
        <li><a href={r.url} rel="noopener"><strong>{r.name}</strong><span>{r.by}{r.note ? `. ${r.note}` : ''}</span><em>{host(r.url)}</em></a></li>
      ))}
    </ul>
    <p class="small">Independent organisations; Universities500 is not connected to them. <a href="/rankings/">How to read the rankings</a></p>
  </section>

  {peers.length > 0 && (
    <section class="sec" aria-labelledby="more">
      <h2 id="more">More universities in {u.countryName}</h2>
      <ul class="grid">
        {peers.map((p) => (
          <li><a class="card" href={`/universities/${p.slug}/`}><strong>{p.name}</strong><span>{p.countryName}</span></a></li>
        ))}
      </ul>
      <p><a href={`/study-in/${u.country}/`}>All universities in {u.countryName}</a></p>
    </section>
  )}
  <RelatedArticles list={forDestination(u.country, 3)} heading={`Reading on studying in ${u.countryName}`} more={[`/articles/destination/${u.country}/`, `All ${u.countryName} articles`]} />
</Base>

<script>
  // Header photos: fade from one to the next every 6.5 seconds. Without script, or with reduced motion, the first photo stays.
  const hero = document.querySelector('[data-hero]');
  if (hero) {
    const imgs = Array.from(hero.querySelectorAll('.uni-hero-bg img'));
    const cr = hero.querySelector('[data-cr]');
    const btn = hero.querySelector('.uni-hero-pause');
    if (imgs.length > 1 && cr && btn) {
      let i = 0;
      let timer = 0;
      let paused = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const load = (img) => { if (img.dataset.src) { img.src = img.dataset.src; delete img.dataset.src; } };
      const el = (tag, text, href) => { const e = document.createElement(tag); if (text) e.textContent = text; if (href) { e.href = href; e.rel = 'noopener'; } return e; };
      const credit = (img) => {
        cr.textContent = '';
        cr.append('Photo: ' + img.dataset.by + (img.dataset.y ? ', ' + img.dataset.y : '') + ', ', el('a', img.dataset.lic, img.dataset.licurl), ', ', el('a', 'Wikimedia Commons', img.dataset.page));
      };
      const show = (n) => { imgs[i].classList.remove('is-on'); i = n; imgs[i].classList.add('is-on'); credit(imgs[i]); };
      const next = () => {
        const n = (i + 1) % imgs.length;
        const t = imgs[n];
        load(t);
        if (t.complete && t.naturalWidth) show(n); else t.addEventListener('load', () => show(n), { once: true });
      };
      const stop = () => { clearInterval(timer); timer = 0; };
      const start = () => { stop(); if (!paused && !document.hidden) timer = setInterval(next, 6500); };
      const label = () => { btn.textContent = paused ? 'Play photos' : 'Pause photos'; btn.setAttribute('aria-pressed', String(paused)); };
      btn.addEventListener('click', () => { paused = !paused; label(); start(); });
      document.addEventListener('visibilitychange', start);
      window.addEventListener('load', () => setTimeout(() => load(imgs[1]), 1200));
      label();
      start();
    }
  }

  // Campus gallery: swipe or scroll sideways; the arrows and the counter follow.
  document.querySelectorAll('[data-slider]').forEach((box) => {
    const track = box.querySelector('.uni-track');
    const n = box.querySelector('[data-n]');
    const prev = box.querySelector('.uni-prev');
    const next = box.querySelector('.uni-next');
    if (!track || !n || !prev || !next) return;
    const count = track.children.length;
    const at = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (d) => track.scrollTo({ left: Math.max(0, Math.min(count - 1, at() + d)) * track.clientWidth, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    const sync = () => { n.textContent = String(at() + 1); prev.disabled = at() <= 0; next.disabled = at() >= count - 1; };
    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    track.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true });
    sync();
  });
</script>
