---
import Base from '../../layouts/Base.astro';
import GuideBlocks from '../../components/GuideBlocks.astro';
import { byCountry, countries, SITE } from '../../lib/data.js';
import { guides, runsText } from '../../lib/guides.js';

export function getStaticPaths() {
  return guides.map((g) => ({ params: { country: g.slug }, props: { g } }));
}
const { g } = Astro.props;
const c = countries.find((x) => x.code === g.slug);
const list = c ? byCountry(c.code) : [];

const plain = (blocks) =>
  blocks
    .map((b) => (b.t === 'p' ? runsText(b.runs) : b.t === 'ul' ? b.items.map((i) => runsText(i.lead) + runsText(i.runs)).join(' ') : ''))
    .join(' ')
    .replace(/\s+/g, ' ')
    .trim();
const overview = g.sections.find((s) => s.key === 'overview');
const first = overview?.blocks.find((b) => b.t === 'p');
const lede = first ? runsText(first.runs).split(/(?<=[.!?])\s+/)[0] : `A guide to studying in ${g.name}.`;
const faq = g.sections.find((s) => s.key === 'faq');
const faqItems = (faq?.blocks || []).filter((b) => b.t === 'qa');
const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: g.title,
    about: g.name,
    mainEntityOfPage: `${SITE}/study-in/${g.slug}/`,
    publisher: { '@type': 'Organization', name: 'Universities500' },
  },
];
if (faqItems.length) {
  ld.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((q) => ({
      '@type': 'Question',
      name: q.q,
      acceptedAnswer: { '@type': 'Answer', text: plain(q.a) },
    })),
  });
}
const toc = g.sections.filter((s) => s.blocks.length);
---
<Base
  title={`Study in ${g.name}: guide for international students | Universities500`}
  description={lede.length > 160 ? lede.slice(0, 157).replace(/\s+\S*$/, '') + '…' : lede}
  path={`/study-in/${g.slug}/`}
  jsonld={ld}
  current="guide"
>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">/</span><a href="/study-in/">Study in</a><span aria-hidden="true">/</span>{g.name}
  </nav>
  <h1>{g.title}</h1>
  <p class="lede">{lede}</p>
  {g.stats.length > 0 && (
    <div class="gstats">
      {g.stats.map((s) => <div class="gstat"><b>{s.v}</b><span>{s.l}</span></div>)}
    </div>
  )}
  <p class="guide-note">Fees, visa settings and work rules change often. Check each one on the official government or university site before you rely on it.</p>

  <div class="guide-lay">
    <nav class="toc" aria-label="In this guide">
      <h2>In this guide</h2>
      <ol>
        {toc.map((s) => <li><a href={`#s-${s.key}`}>{s.title}</a></li>)}
        {list.length > 0 && <li><a href="#s-universities-here">Universities in {g.name} on this site</a></li>}
      </ol>
    </nav>
    <article class="gbody">
      {toc.map((s) => (
        <section class="gsec" id={`s-${s.key}`}>
          <h2>{s.title}</h2>
          <GuideBlocks blocks={s.blocks} />
        </section>
      ))}
      {list.length > 0 && (
        <section class="gsec uni-in-country" id="s-universities-here">
          <h2>Universities in {g.name} on this site</h2>
          <p>{list.length} {list.length === 1 ? 'university' : 'universities'}, listed alphabetically. Each profile links to its sources.</p>
          <ul class="grid">
            {list.map((u) => (
              <li>
                <a class="card" href={`/universities/${u.slug}/`}>
                  <strong>{u.name}</strong>
                  <span>{u.founded ? `Founded ${u.founded.v}` : c.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </article>
  </div>
</Base>
