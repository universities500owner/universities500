---
import Base from '../../layouts/Base.astro';
import { hiddenFromSearch } from '../../lib/noindex.js';
import { countries } from '../../lib/data.js';
import SchCard from '../../components/SchCard.astro';
import { items, PUBLISH, generatedAt, statusOf, STATUS_LABEL, fmtIso, CHECK, lookGroups } from '../../lib/scholarships.js';

const path = '/scholarships/';
const today = new Date().toISOString().slice(0, 10);
const rows = items
  .map((i) => ({ ...i, st: statusOf(i, today) }))
  .sort((a, b) => ['open', 'upcoming', 'unknown', 'closed'].indexOf(a.st) - ['open', 'upcoming', 'unknown', 'closed'].indexOf(b.st) || (a.deadline || '9999').localeCompare(b.deadline || '9999') || a.name.localeCompare(b.name));
const withItems = [...new Set(rows.map((r) => r.country))];
const countryOpts = countries.filter((c) => withItems.includes(c.code));
const perCountry = Object.fromEntries(countryOpts.map((c) => [c.code, rows.filter((r) => r.country === c.code).length]));
const tiles = [...countryOpts].sort((a, b) => perCountry[b.code] - perCountry[a.code] || a.name.localeCompare(b.name));
const groups = lookGroups();
const updated = generatedAt ? fmtIso(generatedAt.slice(0, 10)) : '';
---
<Base
  title="Scholarship search for international students | Universities500"
  description="Search scholarships for international Bachelor's and Master's students. Each one shows its value, deadline, eligibility and the official page to apply, and whether it is open, closed or yet to open."
  path={path}
  noindex={hiddenFromSearch(path)}
  current="scholarships"
>
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span>Scholarships</nav>
  <div class="q-head">
    <h1>Scholarship search</h1>
    <p>Scholarships open to international students on Bachelor's and Master's courses. Every entry links to the official page it was read from.</p>
  </div>

  {PUBLISH && rows.length > 0 ? (
    <>
    <section class="sec" aria-labelledby="h-dest">
      <h2 id="h-dest">Choose a destination</h2>
      <ul class="int-dests">
        {tiles.map((c) => (
          <li>
            <a class="int-dest" href={`/scholarships/?c=${c.code}#sch-bar`}>
              <span class="int-dest-name">{c.name}</span>
              <span class="int-dest-n">{perCountry[c.code]} scholarship{perCountry[c.code] === 1 ? '' : 's'}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="sec" aria-labelledby="h-find">
      <h2 id="h-find" class="sr-only">Search</h2>
      <div class="filterbar" id="sch-bar">
        <input id="sch-q" type="search" placeholder="Name or university" aria-label="Search scholarships by name or university" />
        <select id="sch-c" aria-label="Destination">
          <option value="">All destinations</option>
          {countryOpts.map((c) => <option value={c.code}>{c.name}</option>)}
        </select>
        <select id="sch-l" aria-label="Level">
          <option value="">All levels</option>
          <option value="bachelor">Bachelor</option>
          <option value="master">Master</option>
        </select>
        <select id="sch-s" aria-label="Status">
          <option value="">Any status</option>
          <option value="open">Open</option>
          <option value="upcoming">Yet to open</option>
          <option value="closed">Closed</option>
          <option value="unknown">Check the official page</option>
        </select>
        <select id="sch-o" aria-label="Sort by">
          <option value="status">Open first</option>
          <option value="name">Name A to Z</option>
          <option value="country">Destination</option>
        </select>
        <label class="int-new"><input type="checkbox" id="sch-sv" /> Saved only</label>
      </div>
      <p class="tally" id="sch-tally" role="status">{rows.length} scholarships</p>
      <ol class="rc-list" id="sch-list">
        {rows.map((r) => <SchCard r={r} today={today} />)}
      </ol>
      <p class="more"><button type="button" class="btn-ghost" id="sch-more" hidden>Show more</button></p>
      <p class="small">Last read {updated}. Dates and values are copied from the official page and can change. Check the official page before you apply.</p>
    </section>
    </>
  ) : (
    <div class="note draft">
      <p><strong>Scholarship listings are being checked.</strong> Each entry will appear here once it has an official source and a check date. Until then, use the official places below.</p>
    </div>
  )}

  <section class="sec" aria-labelledby="h-look">
    <h2 id="h-look">Official places to look</h2>
    <p class="sec-lede">Government and agency pages for each destination. These are directories, so they list more than we can show here.</p>
    {groups.length === 0 ? (
      <p>The list is being checked.</p>
    ) : (
      <div class="look">
        {groups.map((g) => (
          <div class="look-c">
            <h3>{g.name}</h3>
            <ul>
              {g.dirs.map((d) => <li><a href={d.url} rel="noopener">{d.title}</a>{d.note && <span class="muted"> {d.note}</span>}</li>)}
              {g.tp.map((t) => <li><a href={t.url} rel="noopener">{t.title}</a> <span class="muted">(independent site) {t.note}</span></li>)}
            </ul>
          </div>
        ))}
      </div>
    )}
  </section>

  <section class="sec" aria-labelledby="h-how">
    <h2 id="h-how">How this list is made</h2>
    <ul>
      <li>A program reads public scholarship pages from official programme sites and from each university's own website every two days. It follows each site's robots.txt and reads slowly.</li>
      <li>Only scholarships open to international students on Bachelor's or Master's courses are kept.</li>
      <li>Every entry shows the page it was read from and the date it was last read. If the program cannot read a field with confidence, the entry says "{CHECK}" instead of guessing.</li>
      <li>Open, closed or yet to open comes only from dates on the official page. With no dates, the status is "{CHECK}".</li>
    </ul>
    <p><a href="/bot/">About our reader</a></p>
  </section>

  <script type="application/json" id="sch-today" set:html={JSON.stringify({ built: today })} />
  {PUBLISH && rows.length > 0 && <script>import '../../scripts/scholarships.js';</script>}
</Base>
