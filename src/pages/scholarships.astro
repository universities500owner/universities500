---
import Base from '../layouts/Base.astro';
import { hiddenFromSearch } from '../lib/noindex.js';
import tools from '../data/tools.json';
const path = '/scholarships/';
const data = JSON.stringify({ SCH: tools.SCH }).replace(/</g, '\\u003c');
---
<Base
  title="Scholarships: filter by destination and level | Universities500"
  description="Filter scholarships by destination and level, then shortlist the ones whose deadline you can make."
  path={path}
  noindex={hiddenFromSearch(path)}
  current="scholarships"
>
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span>Scholarships</nav>
  <div class="q-head">
    <h1>Scholarships</h1>
    <p>Filter by destination and level, then shortlist the ones whose deadline you can make.</p>
  </div>

  <section class="sec" aria-labelledby="h-sch">
    <h2 id="h-sch">Find the money before you pick the course</h2>
    <p class="sec-lede">Most scholarship deadlines close months ahead of the course deadline. Filter, then shortlist the ones actually worth the application time. These entries are placeholders, not real programmes. Your shortlist is saved in this browser only.</p>
    <div class="filterbar">
      <input id="sc-q" type="search" placeholder="Search by name" aria-label="Search scholarships" />
      <select id="sc-c" aria-label="Filter by country"></select>
      <select id="sc-l" aria-label="Filter by level"></select>
    </div>
    <p class="tally" id="sc-tally" role="status"></p>
    <div id="sc-list"></div>
    <p class="shortlist" id="sc-short"></p>
  </section>
  <p class="note draft">Every entry on this page is a labelled placeholder. Nothing here is a real scholarship. Check each funder's own page for what is on offer and when it closes.</p>

  <script type="application/json" id="tool-data" set:html={data} />
  <script>import '../scripts/scholarships.js';</script>
</Base>
