---
import Base from '../layouts/Base.astro';
import '../styles/home-v1.tokens.css';
import '../styles/home-v1.css';
import { all, countries, SITE } from '../lib/data.js';
import { PUBLISH as SCH_ON, items as schItems } from '../lib/scholarships.js';
import { PUBLISH as INT_ON, items as intItems } from '../lib/internships.js';
import { PUBLISH as CRS_ON, items as crsItems, total as crsTotal } from '../lib/courses.js';
import { PUBLISH as MBA_ON, items as mbaItems } from '../lib/mba.js';
import { exams } from '../lib/exams.js';
import { SOP, LOR } from '../lib/prep.js';

// Decorative rings, drawn once at build time.
const rings = Array.from({ length: 26 }, (_, i) => ({
  rx: 70 + i * 13,
  ry: 26 + i * 6.2,
  rot: i * 7,
  op: (0.5 - i * 0.012).toFixed(3),
}));

const crsLive = CRS_ON && crsTotal > 0;
const n = (x) => x.toLocaleString('en-GB');
const plural = (k, one, many) => `${n(k)} ${k === 1 ? one : many}`;

// What a student can do here, in the order a student meets it: find, get application-ready, fund it and get there.
// A count is shown only where there is something real to count. English tests and exams are guides today, so they are named as guides.
const groups = [
  { id: 'find', title: 'Find where to study', tiles: [
    { id: 'courses', name: 'Course search', text: "Bachelor's and Master's courses by subject, country and English score.", href: '/courses/', stat: crsLive ? `${n(crsTotal)} courses` : 'Sample search' },
    { id: 'universities', name: 'University search', text: 'Universities by country, each with its official website and sources.', href: '/universities/', stat: `${n(all.length)} universities` },
    { id: 'destinations', name: 'Destinations and guides', text: 'Costs, visas, work rights and student life, country by country.', href: '/study-in/', stat: `${n(countries.length)} destinations` },
    { id: 'mba', name: 'MBA Explorer', text: "MBA, master's in management and Executive MBA, by the experience you have.", href: '/mba/', stat: MBA_ON && mbaItems.length ? `${plural(mbaItems.length, 'programme', 'programmes')} so far` : 'Coming soon' },
  ] },
  { id: 'prepare', title: 'Get application-ready', tiles: [
    { id: 'english', half: true, name: 'English tests', text: 'IELTS, TOEFL or PTE: which to sit, and how to prepare.', href: '/english-test/', stat: 'Guide', chips: ['IELTS', 'TOEFL', 'PTE'] },
    { id: 'exams', half: true, name: 'Study abroad exams', text: 'SAT, GRE, GMAT and more: which one your level and country need.', href: '/exams/', stat: plural(exams.length, 'exam guide', 'exam guides'), chips: ['SAT', 'GRE', 'GMAT'] },
    { id: 'sop', wide: true, name: 'SOP and LOR writing tips', text: 'The two parts of an application nobody can write for you, and the two that decide most borderline cases.', href: '/application-prep/#h-letters', stat: 'Read the full steps',
      tips: [['Statement of purpose', SOP.slice(0, 2)], ['Recommendation letters', LOR.slice(0, 2)]] },
  ] },
  { id: 'fund', title: 'Fund it and get there', tiles: [
    { id: 'scholarships', name: 'Scholarships', text: 'Open to international students, with value, deadline and the official page.', href: '/scholarships/', stat: SCH_ON && schItems.length ? plural(schItems.length, 'scholarship', 'scholarships') : 'Where to look' },
    { id: 'internships', name: 'Internships', text: 'Internships, co-ops and placements, each opening on the employer’s page.', href: '/internships/', stat: INT_ON && intItems.length ? plural(intItems.length, 'listing', 'listings') : 'Where to look' },
    { id: 'loan', name: 'Education loan guidance', text: 'RBI rules, collateral, lenders, and what a loan costs over its life.', href: '/education-loan-guide/', stat: 'Guide and calculator' },
    { id: 'visa', name: 'Visa guidance', text: 'What a student visa asks for in each destination, and what you have.', href: '/visa-readiness/', stat: 'Checklist by destination' },
  ] },
];

// Suggestions under the search box. Each one opens a page that works today.
const tries = [
  ['Nursing courses', '/courses/?q=nursing'],
  ["Master's in Canada", '/courses/?c=canada&l=master'],
  ['Scholarships in Germany', '/scholarships/?c=germany'],
  ["MBA with 3 to 5 years' experience", '/mba/?track=mid'],
  ['IELTS or PTE?', '/english-test/'],
  ['Loan without collateral', '/education-loan-guide/'],
];

const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Universities500',
    url: SITE + '/',
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: SITE + '/search/?q={search_term_string}' },
      'query-input': 'required name=search_term_string',
    },
  },
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'Universities500', url: SITE + '/', logo: SITE + '/brand/mark-light.png' },
];
---
<Base
  title="Universities500: courses, universities, scholarships and internships for students abroad"
  description={`Search courses, universities, scholarships and internships, and get guidance on English tests, exams, education loans and visas. Every fact links to its source.`}
  path="/"
  jsonld={ld}
  wide={true}
  news={true}
>
  <div class="home-v1 home-v2">
    <section class="hero" aria-labelledby="h-hero">
      <svg class="guilloche" viewBox="0 0 800 420" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1">
        <g>
          {rings.map((r) => (
            <ellipse cx="560" cy="300" rx={r.rx} ry={r.ry} transform={`rotate(${r.rot} 560 300)`} opacity={r.op} />
          ))}
        </g>
      </svg>
      <div class="wrap hero-in">
        <h1 id="h-hero">Search everything about studying abroad.</h1>
        <p class="hero-sub">Courses, universities, scholarships and internships, with the tests, loans and visas that come with them. Every fact links to its source.</p>

        <form class="askbar" action="/search/" method="get" role="search" autocomplete="off">
          <label class="sr-only" for="ask-q">Search Universities500</label>
          <div class="ask-field">
            <svg width="22" height="22" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="7" cy="7" r="5" /><path d="m11 11 3.5 3.5" /></svg>
            <input id="ask-q" name="q" type="search" placeholder="Ask in your own words, for example: nursing master’s in Canada" data-short="Nursing in Canada" enterkeyhint="search" />
            <button class="btn" type="submit">Search</button>
          </div>
        </form>
        <ul class="ask-try" aria-label="Try one of these">
          {tries.map(([t, href]) => <li><a class="sx-q" href={href}>{t}</a></li>)}
        </ul>
      </div>
    </section>

    <section class="band tiles-band" aria-labelledby="h-tiles">
      <h2 id="h-tiles" class="sr-only">Everything on Universities500</h2>
      {groups.map((g) => (
        <div class={`tgroup grp-${g.id}`}>
          <div class="wrap">
            <h3 class="tgroup-h">{g.title}</h3>
            <ul class="tiles">
              {g.tiles.map((t) => (
                <li class={`tile${t.wide ? ' tile-wide' : ''}${t.half ? ' tile-half' : ''}`}>
                  <div class="tile-head">
                    <span class="tile-go" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 12h15M13 6l6 6-6 6" /></svg></span>
                    <a class="tile-name" href={t.href}>{t.name}</a>
                  </div>
                  <div class="tile-body">
                    <p class="tile-txt">{t.text}</p>
                    {t.chips && <ul class="tile-chips">{t.chips.map((c) => <li>{c}</li>)}</ul>}
                    {t.tips && (
                      <div class="tile-tips">
                        {t.tips.map(([h, list]) => (
                          <div>
                            <h4>{h}</h4>
                            <ul>{list.map((x) => <li>{x}</li>)}</ul>
                          </div>
                        ))}
                      </div>
                    )}
                    <p class="tile-stat">{t.stat}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
      <div class="wrap">
        <p class="trust">Every fact links to its official source and shows the date we read it. Fees and rules change, so check the official page before you act. <a href="/disclaimer/">Disclaimer and data sources</a></p>
      </div>
    </section>
  </div>

  <script is:inline>
    (function () {
      var q = document.getElementById('ask-q');
      if (q && window.matchMedia('(max-width: 560px)').matches) q.setAttribute('placeholder', q.getAttribute('data-short'));
    })();
  </script>

  <style is:global>
    .home-v2 .wrap { max-width: var(--wrap); padding-inline: 1.25rem; }
    .home-v2 .sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
    .home-v2 .hero { padding: clamp(2.25rem, 6vw, 4.5rem) 0 clamp(1.75rem, 4vw, 3rem); }
    .home-v2 .guilloche { transform: translate(-42%, -66%); width: 66rem; }
    @media (max-width: 959px) { .home-v2 .guilloche { display: block; width: 44rem; transform: translate(-50%, -60%); opacity: 0.7; } }
    .home-v2 .hero-in { display: block; }
    .home-v2 .hero h1 { font-size: clamp(2.4rem, 5.6vw, 4.1rem); max-width: 17ch; margin-bottom: clamp(1rem, 2.4vw, 1.4rem); }
    .home-v2 .hero-sub { max-width: 54ch; margin-bottom: clamp(1.4rem, 3.2vw, 2.1rem); }
    .home-v2 .askbar { max-width: 56rem; margin: 0 0 0.9rem; position: relative; z-index: 5; }
    .home-v2 .ask-field { display: flex; align-items: center; gap: 0.75rem; background: var(--field); border: 2px solid var(--accent); border-radius: 999px; padding: 0.45rem 0.5rem 0.45rem 1.4rem; box-shadow: 0 18px 40px -26px var(--shadow); }
    .home-v2 .ask-field:focus-within { border-color: var(--ink); }
    .home-v2 .ask-field svg { flex: 0 0 auto; color: var(--muted); }
    .home-v2 .ask-field input { flex: 1 1 0; min-width: 0; border: 0; outline: 0; background: transparent; color: var(--ink); font: inherit; font-size: clamp(1rem, 2.2vw, 1.2rem); padding: 0.8rem 0; }
    .home-v2 .ask-field input::placeholder { color: var(--muted); opacity: 1; }
    .home-v2 .ask-field .btn { padding: 0.8rem 1.8rem; font-size: 1.05rem; }
    .home-v2 .ask-try { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; position: relative; z-index: 4; max-width: 56rem; }
    .home-v2 .sx-q { display: inline-flex; align-items: center; text-decoration: none; border: 1px solid var(--line); background: var(--paper); border-radius: 999px; padding: 0.32rem 0.85rem; font-size: 0.92rem; color: var(--ink); }
    .home-v2 .sx-q:hover { border-color: var(--ink); }
    /* Three edge-to-edge colour bands. Inside each, panels sit flush with a thin divider, like one wall of colour. */
    .home-v2 .tiles-band { padding: 0; border-top: 0; }
    .home-v2 .tgroup { background: var(--g); color: var(--g-on); padding: clamp(1.75rem, 4vw, 2.75rem) 0 clamp(1.75rem, 4vw, 2.5rem); }
    .home-v2 .tgroup-h { font-size: clamp(2rem, 4.6vw, 3rem); line-height: 1.05; letter-spacing: -0.025em; font-weight: 800; color: var(--g-on); max-width: none; margin: 0 0 clamp(1rem, 2.4vw, 1.5rem); }
    /* --g band, --g-on text on it, --g-line dividers, --g-alt every second panel, --g-hover on hover, --g-arrow arrows, --g-pill / --g-pillbg stat pill. */
    .home-v2 .grp-find { --g: var(--blue-4); --g-on: #fff; --g-line: rgba(255, 255, 255, 0.34); --g-alt: rgba(0, 21, 34, 0.16); --g-hover: rgba(255, 255, 255, 0.14); --g-arrow: #A8E0FF; --g-pill: var(--blue-3); --g-pillbg: #fff; }
    .home-v2 .grp-prepare { --g: var(--green-2); --g-on: #fff; --g-line: rgba(255, 255, 255, 0.34); --g-alt: rgba(0, 21, 34, 0.18); --g-hover: rgba(255, 255, 255, 0.14); --g-arrow: var(--green-7); --g-pill: var(--green-1); --g-pillbg: #fff; }
    .home-v2 .grp-fund { --g: var(--warm-2); --g-on: var(--blue-1); --g-line: rgba(0, 21, 34, 0.32); --g-alt: rgba(255, 255, 255, 0.2); --g-hover: rgba(0, 21, 34, 0.1); --g-arrow: var(--blue-1); --g-pill: var(--warm-1); --g-pillbg: var(--blue-1); }
    .home-v2 .tiles { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; background: var(--g-line); border-top: 1px solid var(--g-line); border-bottom: 1px solid var(--g-line); grid-template-columns: repeat(2, minmax(0, 1fr)); }
    @media (min-width: 1000px) { .home-v2 .tiles { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
    @media (max-width: 560px) { .home-v2 .tiles { grid-template-columns: minmax(0, 1fr); } }
    .home-v2 .tile, .home-v2 .tile:hover { background-color: var(--g); }
    .home-v2 .tile { position: relative; display: flex; flex-direction: column; gap: 0; min-height: 0; border: 0; border-radius: 0; padding: 1.5rem 1.4rem 1.35rem; color: var(--g-on); }
    .home-v2 .tile:nth-child(even) { background-image: linear-gradient(var(--g-alt), var(--g-alt)); }
    .home-v2 .tile:hover { background-image: linear-gradient(var(--g-hover), var(--g-hover)); }
    .home-v2 .tile:nth-child(even):hover { background-image: linear-gradient(var(--g-alt), var(--g-alt)), linear-gradient(var(--g-hover), var(--g-hover)); }
    .home-v2 .tile:focus-within { outline: 3px solid var(--g-on); outline-offset: -6px; }
    .home-v2 .tile-wide { grid-column: 1 / -1; }
    @media (min-width: 1000px) { .home-v2 .tile-half { grid-column: span 2; } }
    .home-v2 .tile-head { display: flex; align-items: flex-start; gap: 0.6rem; margin-bottom: 0.7rem; }
    .home-v2 .tile-go { flex: 0 0 auto; display: grid; place-items: center; width: 1.5rem; height: 1.5rem; margin-top: 0.12em; color: var(--g-arrow); transition: transform 0.15s; }
    .home-v2 .tile:hover .tile-go { transform: translateX(4px); }
    .home-v2 .tile-go svg { width: 1.5rem; height: 1.5rem; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
    .home-v2 .tile-name { font-family: var(--display); font-weight: 800; font-size: clamp(1.55rem, 2.3vw, 2rem); line-height: 1.08; letter-spacing: -0.02em; color: var(--g-on); text-decoration: none; text-underline-offset: 0.18em; text-decoration-thickness: 2px; }
    .home-v2 .tile:hover .tile-name { text-decoration-line: underline; }
    .home-v2 .tile-name::after { content: ''; position: absolute; inset: 0; }
    .home-v2 .tile-name:focus-visible { outline: none; }
    .home-v2 .tile-body { flex: 1 1 auto; display: flex; flex-direction: column; align-items: flex-start; padding-left: 2.1rem; }
    .home-v2 .tile-txt { font-size: 1.05rem; line-height: 1.45; font-weight: 500; color: var(--g-on); margin: 0 0 1rem; }
    .home-v2 .tile-chips { list-style: none; margin: 0 0 1rem; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
    .home-v2 .tile-chips li { font-size: 0.9rem; font-weight: 700; border-radius: 999px; padding: 0.15rem 0.75rem; color: var(--g-on); background: color-mix(in srgb, var(--g-on) 20%, transparent); }
    .home-v2 .tile-tips { display: grid; gap: 1rem 2rem; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-bottom: 1rem; width: 100%; }
    @media (max-width: 700px) { .home-v2 .tile-tips { grid-template-columns: minmax(0, 1fr); } }
    .home-v2 .tile-tips h4 { font-family: var(--display); font-weight: 800; font-size: 1.15rem; margin: 0 0 0.35rem; letter-spacing: -0.01em; color: var(--g-on); }
    .home-v2 .tile-tips ul { margin: 0; padding-left: 1.1rem; font-size: 1rem; line-height: 1.45; font-weight: 500; color: var(--g-on); }
    .home-v2 .tile-tips li { margin: 0 0 0.3rem; }
    .home-v2 .tile-stat { margin-top: auto; font-size: 0.92rem; font-weight: 700; line-height: 1.3; color: var(--g-pill); background: var(--g-pillbg); border-radius: 999px; padding: 0.25rem 0.9rem; }
    @media (max-width: 560px) {
      .home-v2 .tiles { margin-inline: -1.25rem; }
      .home-v2 .tile { padding: 1.15rem 1.25rem 1.1rem; }
      .home-v2 .tile-head { margin-bottom: 0.5rem; }
      .home-v2 .tile-body { padding-left: 2.1rem; }
      .home-v2 .tile-txt { margin-bottom: 0.8rem; }
    }
    .home-v2 .trust { margin-top: 1.5rem; margin-bottom: 0.5rem; font-size: 0.9rem; color: var(--muted); max-width: 70ch; line-height: 1.55; }
    .home-v2 .trust a { color: var(--accent); }
    .home-v2 a.btn { text-decoration: none; }
  </style>
</Base>
