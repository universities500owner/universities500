---
import Base from '../layouts/Base.astro';
import NewsFeedItem from '../components/NewsFeedItem.astro';
import { PUBLISH, feed, destinations, COLOR, sourcesFor, lastChecked, lastCheckedAny, fmtIso } from '../lib/news.js';

const path = '/industry-news/';
const NOTE = { blocked: 'its website does not allow automatic reading, so open it to see its news', unreadable: 'no headlines could be read automatically, so open it to see its news', failed: 'could not be reached at the last check' };
const live = PUBLISH;
const where = destinations.map((c) => ({ ...c, srcs: sourcesFor(c.code), checked: lastChecked(c.code) })).filter((c) => c.srcs.length > 0);
---
<Base
  title="Industry news for international students | Universities500"
  description="The latest visa, fee and rule changes for international students in 14 study destinations, newest first: official notices from governments and study agencies, and reports from the trade press."
  path={path}
  noindex={!live}
  current="industry-news"
  news={false}
>
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span>Industry news</nav>
  <div class="q-head">
    <h1>Industry news</h1>
    <p>Visa, fee and rule changes for international students across 14 study destinations, newest first. Official notices and trade-press reports are mixed together and every item is labelled.</p>
  </div>

  {!live && (
    <div class="note draft">
      <p><strong>Industry news is being checked.</strong> Updates will appear here once the daily reading of official sources has been reviewed.</p>
    </div>
  )}

  {live && (
    <Fragment>
      <div class="feed-filters" id="feed-filters" hidden>
        <div class="segs" role="group" aria-label="Destination">
          <button type="button" class="seg" data-all aria-pressed="true">All destinations</button>
          {destinations.map((c) => (
            <button type="button" class="seg" data-c={c.code} data-name={c.name} data-n={c.n} aria-pressed="false">
              <i class="dot" style={`--c:${COLOR[c.code] || 'var(--muted)'}`} aria-hidden="true"></i>{c.name}<span class="seg-n">{c.n}</span>
            </button>
          ))}
        </div>
        <div class="segs" role="group" aria-label="Source type">
          <button type="button" class="seg" data-k="all" aria-pressed="true">All sources</button>
          <button type="button" class="seg" data-k="official" aria-pressed="false">Official only</button>
        </div>
        <p class="feed-count" id="feed-count" role="status"></p>
      </div>

      <ul class="feed" id="feed">
        {feed.map((e) => <NewsFeedItem item={e} />)}
      </ul>
      <p class="feed-empty" id="feed-empty" hidden></p>
      <p class="feed-more"><button type="button" class="btn-ghost" id="feed-more" hidden>Show more</button></p>

      <p class="small feed-fine">
        <strong>Official:</strong> the headline and date are the official body's own, and the short note is the first sentences of its summary, shortened, never rewritten.
        <strong>Trade press:</strong> sector bodies and trade publications (UKCISA, CBIE, NAFSA, ICEF Monitor, The PIE News and others); headline, date and link only. They are not official sources, so check any change on the official website.
        We keep the last 12 months of English-language pages{lastCheckedAny ? `, checked every day, last on ${fmtIso(lastCheckedAny)}` : ''}. This is not legal or immigration advice: read the official notice before you act.
      </p>

      <details class="feed-where" id="where">
        <summary>Where we look, and what we could not read</summary>
        <ul>
          {where.map((c) => (
            <li>
              <strong>{c.name}.</strong>{' '}
              {c.srcs.map((s, k) => (
                <Fragment>{k > 0 ? '; ' : ''}<a href={s.url} rel="noopener">{s.body}</a>{NOTE[s.status] ? ` (${NOTE[s.status]})` : ''}</Fragment>
              ))}
              {c.checked ? `. Last checked ${fmtIso(c.checked)}.` : '.'}
            </li>
          ))}
        </ul>
      </details>
      <script>import '../scripts/news-feed.js';</script>
    </Fragment>
  )}
</Base>
