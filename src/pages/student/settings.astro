---
import Student from '../../layouts/Student.astro';
---
<Student title="Settings" lede="Your sign-in, your emails and your data." active="settings">
  <section class="st-card" aria-labelledby="st-acct-h">
    <h2 id="st-acct-h">Your account</h2>
    <dl class="st-dl">
      <dt>Signed in as</dt><dd data-email></dd>
      <dt>Account created</dt><dd data-since></dd>
    </dl>
    <p class="hint" style="margin-top:.8rem">You sign in with a code emailed to this address, so there is no password to keep safe.</p>
  </section>

  <section class="st-card" aria-labelledby="st-mail-h">
    <h2 id="st-mail-h">Emails</h2>
    <p class="st-sub">We always email you sign-in codes. Anything else is optional.</p>
    <label class="st-chk"><input type="checkbox" id="st-marketing" /><span>Send me occasional study-abroad updates.</span></label>
    <p class="st-status" data-marketing-status role="status" aria-live="polite"></p>
  </section>

  <section class="st-card" aria-labelledby="st-data-h">
    <h2 id="st-data-h">Your data</h2>
    <p class="st-sub">We keep your Gmail address and what you add on your dashboard. No passwords, phone numbers, passport numbers or documents. Read the <a href="/privacy/">Privacy page</a> for more.</p>
    <div class="st-actions" style="margin-top:0">
      <a class="btn ghost" href="/api/me/export" download>Download my data</a>
    </div>
  </section>

  <section class="st-card st-danger" aria-labelledby="st-del-h">
    <h2 id="st-del-h">Delete my account</h2>
    <p class="st-sub">This removes your sign-in and everything you added: plans, profile and history. It cannot be undone. Anything saved only in this browser, like a course shortlist, stays on this device.</p>
    <details class="st-more">
      <summary>I want to delete my account</summary>
      <div class="st-confirm">
        <div class="f">
          <label for="st-del-text">Type <strong>delete</strong> to confirm</label>
          <input id="st-del-text" type="text" autocomplete="off" autocapitalize="none" spellcheck="false" />
        </div>
        <div class="st-actions">
          <button class="btn-danger" type="button" data-del-go disabled>Delete my account</button>
          <p class="st-status" data-del-status role="status" aria-live="polite"></p>
        </div>
      </div>
    </details>
  </section>

  <script>import '../../scripts/student.js';</script>
</Student>
