---
import Base from '../../layouts/Base.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import { forTopics, TOOL_TOPICS } from '../../lib/articles.js';
import InternList from '../../components/InternList.astro';
import { hiddenFromSearch } from '../../lib/noindex.js';
import { countries } from '../../lib/data.js';
import { items, PUBLISH, counts, generatedAt, fmtIso, attributions } from '../../lib/internships.js';

const path = '/internships/';
const today = new Date().toISOString().slice(0, 10);
const CAP = 1000;
const rows = items.slice(0, CAP);
const dests = [...countries].sort((a, b) => counts[b.code] - counts[a.code] || a.name.localeCompare(b.name));
const live = PUBLISH && items.length > 0;
const updated = generatedAt ? fmtIso(generatedAt.slice(0, 10)) : '';
---
<Base
  title="Internships abroad for students | Universities500"
  description="Search internships, co-ops and placements in 14 study destinations. Each one shows the role, the company and the city, and links to the employer's own page."
  path={path}
  noindex={hiddenFromSearch(path)}
  current="internships"
>
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span>Internships</nav>
  <div class="q-head">
    <h1>Find an internship abroad</h1>
    <p>Internships, co-ops and placements in the countries you can study in. Search by role, company or city, and narrow by destination or type. Every listing opens on the employer's own page.</p>
  </div>

  {!live && (
  <section class="sec" aria-labelledby="h-dest">
    <h2 id="h-dest">Choose a destination</h2>
    <ul class="int-dests">
      {dests.map((c) => (
        <li>
          <a class="int-dest" href={`/internships/${c.code}/`}>
            <span class="int-dest-name">{c.name}</span>
            <span class="int-dest-n">{live && counts[c.code] > 0 ? `${counts[c.code]} listing${counts[c.code] === 1 ? '' : 's'}` : 'Where to look'}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
  )}

  <section class="sec" aria-labelledby="h-find">
    <h2 id="h-find">{live ? 'Newest internships' : 'Internship listings'}</h2>
    {live ? (
      <Fragment>
        <InternList rows={rows} today={today} byDestination={true} destinations={dests.filter((c) => counts[c.code] > 0)} />
        {items.length > CAP && <p class="small">Showing the newest {CAP} of {items.length}. Open a destination to see all of its listings.</p>}
        <p class="small">Last read {updated}. Listings are read from employers' own job pages and can close at any time. Check the listing and the visa rules for your course before you apply.</p>
        <p class="small">Where to look, by destination:{dests.map((c, i) => <Fragment>{i > 0 ? ' · ' : ' '}<a href={`/internships/${c.code}/`}>{c.name}</a></Fragment>)}</p>
      </Fragment>
    ) : (
      <div class="note draft">
        <p><strong>Internship listings are being checked.</strong> Each one will appear here once it has been read from an employer's own page and checked. Until then, each destination page lists the places to look.</p>
      </div>
    )}
  </section>

  <section class="sec" aria-labelledby="h-rules">
    <h2 id="h-rules">Can you do an internship on your visa?</h2>
    <p>That depends on your visa, your course and the country. Some destinations limit work hours, and some need a separate permit for a co-op or a placement. We do not say who is eligible for a listing. Read the work rules for your destination first.</p>
    <p><a class="btn ghost" href="/working-while-you-study/">Working while you study</a></p>
  </section>

  {attributions.length > 0 && <p class="small source-line">{attributions.join(' ')}</p>}

  {PUBLISH && rows.length > 0 && <script>import '../../scripts/internships.js';</script>}
  <RelatedArticles list={forTopics(TOOL_TOPICS['internships'], 3)} heading="Related articles" more={['/articles/', 'All articles']} />
</Base>
