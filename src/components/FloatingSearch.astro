---
// The search panel behind the round search button in the corner of every page (not on the Search page itself).
// It opens as a sheet from the bottom on phones and a small card in the corner on larger screens.
// Search runs on this device: what is typed is not sent anywhere or saved. The search data (about 1.5 MB before
// compression) is fetched only when the panel is first opened. Without JavaScript the button is a plain link to /search/.
const tries = ['masters in nursing in canada', 'data science under 25000 AUD', 'scholarships for engineering in germany', 'bachelor business UK IELTS 6', 'student visa canada', 'work rights ireland'];
---
<dialog class="fs" id="fs" aria-labelledby="fs-title">
  <div class="fs-card">
    <div class="fs-top">
      <h2 class="fs-title" id="fs-title">Search Universities500</h2>
      <button class="fs-close" id="fs-close" type="button" aria-label="Close search">
        <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M3 3l10 10M13 3L3 13" /></svg>
      </button>
    </div>
    <form class="fs-form" id="fs-form" role="search" action="/search/" method="get">
      <input id="fs-q" type="search" name="q" placeholder="Try “masters in nursing in canada”" aria-label="Search the site" autocomplete="off" enterkeyhint="search" />
      <button class="btn" type="submit">Search</button>
    </form>
    <div class="fs-body" id="fs-body">
      <p class="fs-priv">Ask in plain words. Search runs on this device. What you type is not sent anywhere or saved.</p>
      <div id="fs-says"></div>
      <p class="fs-tally" id="fs-tally" role="status" aria-live="polite"></p>
      <div id="fs-out"></div>
      <ul class="fs-try" id="fs-try" aria-label="Try searching for">
        {tries.map((t) => <li><button type="button" data-q={t}>{t}</button></li>)}
      </ul>
    </div>
    <div class="fs-foot" id="fs-foot" hidden></div>
  </div>
</dialog>
<script>
  // Opens at once on the tap; the search code itself is fetched on the first open.
  const open = document.getElementById('fs-open');
  const dlg = document.getElementById('fs') as HTMLDialogElement | null;
  if (open && dlg && typeof dlg.showModal === 'function') {
    const root = document.documentElement;
    const input = document.getElementById('fs-q') as HTMLInputElement;
    const vv = window.visualViewport;
    let opener: HTMLElement | null = null;
    let started = false;

    // On a phone the on-screen keyboard covers the bottom of the page, so keep the sheet above it.
    const fit = () => {
      if (!vv) return;
      dlg.style.setProperty('--fs-h', `${vv.height}px`);
      dlg.style.setProperty('--fs-bottom', `${Math.max(0, window.innerHeight - vv.height - vv.offsetTop)}px`);
    };
    const close = () => { if (dlg.open) dlg.close(); };

    open.addEventListener('click', (ev) => {
      if (ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey || ev.button !== 0) return;   // "open in a new tab" still works
      ev.preventDefault();
      opener = open;
      root.classList.add('fs-lock');
      dlg.showModal();
      fit();
      vv?.addEventListener('resize', fit);
      vv?.addEventListener('scroll', fit);
      input.focus();
      if (!started) {
        started = true;
        import('../scripts/search-bubble.js').then((m) => m.start(dlg)).catch(() => {
          const t = document.getElementById('fs-tally');
          if (t) t.textContent = 'Search could not load. Close this and try again, or use the Search page.';
        });
      }
    });
    document.getElementById('fs-close')?.addEventListener('click', close);
    dlg.addEventListener('click', (ev) => { if (ev.target === dlg) close(); });   // a tap outside the panel
    dlg.addEventListener('keydown', (ev) => {
      // Escape closes the panel even while the search box has text (the box would otherwise clear first).
      if (ev.key === 'Escape') { ev.preventDefault(); close(); return; }
      // Tab goes round inside the panel instead of out to the browser's own controls.
      if (ev.key !== 'Tab') return;
      const items = Array.from(dlg.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), input:not([disabled])')).filter((el) => el.getClientRects().length > 0);
      if (!items.length) return;
      const first = items[0], last = items[items.length - 1];
      if (ev.shiftKey && document.activeElement === first) { ev.preventDefault(); last.focus(); }
      else if (!ev.shiftKey && document.activeElement === last) { ev.preventDefault(); first.focus(); }
    });
    dlg.addEventListener('close', () => {
      root.classList.remove('fs-lock');
      vv?.removeEventListener('resize', fit);
      vv?.removeEventListener('scroll', fit);
      if (opener && document.contains(opener)) opener.focus();
    });
  }
</script>
