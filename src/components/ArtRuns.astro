---
// Formatted text for an article: bold, italic, line breaks and links.
const { runs = [] } = Astro.props;
---
{runs.map((r) => {
  if (r.br) return <br />;
  const inner = r.b && r.i ? <strong><em>{r.t}</em></strong> : r.b ? <strong>{r.t}</strong> : r.i ? <em>{r.t}</em> : r.t;
  return r.href ? <a href={r.href}>{inner}</a> : inner;
})}
