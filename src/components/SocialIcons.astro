---
// Official Instagram, LinkedIn and YouTube pages as one-colour icons (they take the text colour of where they sit).
const { links = {}, name = '' } = Astro.props;
const labels = { instagram: 'Instagram', linkedin: 'LinkedIn', youtube: 'YouTube' };
const have = Object.keys(labels).filter((k) => links[k]);
---
{have.length > 0 && (
  <ul class="soc" aria-label={`${name} on social media`}>
    {have.map((k) => (
      <li>
        <a href={links[k]} rel="noopener" aria-label={`${name} on ${labels[k]}`} title={labels[k]}>
          {k === 'instagram' && (
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5" /><circle cx="12" cy="12" r="4.1" /><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none" /></svg>
          )}
          {k === 'linkedin' && (
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M5 3.2a2 2 0 1 1 0 4 2 2 0 0 1 0-4ZM3.3 9h3.4v11.7H3.3V9Zm5.5 0h3.2v1.6h.05c.45-.85 1.55-1.85 3.2-1.85 3.4 0 4 2.2 4 5.1v6.85h-3.4v-6c0-1.45 0-3.25-2-3.25s-2.3 1.55-2.3 3.15v6.1H8.8V9Z" /></svg>
          )}
          {k === 'youtube' && (
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M21.6 7.2a2.6 2.6 0 0 0-1.8-1.85C18.2 4.9 12 4.9 12 4.9s-6.2 0-7.8.45A2.6 2.6 0 0 0 2.4 7.2C2 8.8 2 12 2 12s0 3.2.4 4.8a2.6 2.6 0 0 0 1.8 1.85c1.6.45 7.8.45 7.8.45s6.2 0 7.8-.45a2.6 2.6 0 0 0 1.8-1.85C22 15.2 22 12 22 12s0-3.2-.4-4.8ZM10 15.1V8.9l5.2 3.1-5.2 3.1Z" /></svg>
          )}
        </a>
      </li>
    ))}
  </ul>
)}
