---
// Search bar and list of internships. Used by /internships/ (all destinations) and /internships/<country>/.
import IntCard from './IntCard.astro';
import { KIND_LABEL } from '../lib/internships.js';
const { rows, today, byDestination = false, destinations = [] } = Astro.props;
---
<div class="filterbar" id="int-bar">
  <input id="int-q" type="search" placeholder="Role, company, team or city" aria-label="Search internships by role, company, team or city" />
  {byDestination && (
    <select id="int-c" aria-label="Destination">
      <option value="">All destinations</option>
      {destinations.map((c) => <option value={c.code}>{c.name}</option>)}
    </select>
  )}
  <select id="int-k" aria-label="Type">
    <option value="">All types</option>
    {Object.entries(KIND_LABEL).map(([v, l]) => <option value={v}>{l}</option>)}
  </select>
  <select id="int-o" aria-label="Sort by">
    <option value="new">Newest first</option>
    <option value="org">Company A to Z</option>
    <option value="title">Role A to Z</option>
  </select>
  <label class="int-new"><input type="checkbox" id="int-n" /> New this week</label>
  <label class="int-new"><input type="checkbox" id="int-sv" /> Saved only</label>
</div>
<p class="tally" id="int-tally" role="status">{rows.length} internships</p>
<ol class="rc-list" id="int-list">
  {rows.map((r) => <IntCard r={r} today={today} />)}
</ol>
<p class="more"><button type="button" class="btn-ghost" id="int-more" hidden>Show more</button></p>
